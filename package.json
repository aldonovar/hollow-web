{
  "name": "hollow-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test:audio-cloud": "node --test --experimental-strip-types src/daw/services/storage/audioAssetFormat.test.ts src/daw/services/storage/projectAudioAssetService.test.ts",
    "test:audio-import": "node --test --experimental-strip-types src/daw/services/audioImportContract.test.ts src/daw/services/aiffPcmDecoder.test.ts",
    "test:portable-project": "node --test --experimental-strip-types src/daw/services/storage/portableProjectBundleService.test.ts src/daw/services/storage/portableProjectAssetCacheService.test.ts src/daw/services/platformProjectFileService.test.ts src/daw/portableProjectIntegration.test.ts",
    "test:responsive": "node --test --experimental-strip-types src/daw/responsiveShell.test.ts",
    "test:transport": "node --test src/daw/components/Transport.test.mjs",
    "test:midi": "node --test --experimental-strip-types src/daw/services/MidiService.test.ts",
    "test:ai-safety": "node --test --experimental-strip-types src/daw/services/aiGatewayService.test.ts",
    "test:app-resilience": "node --test --experimental-strip-types src/appErrorBoundary.test.ts",
    "test:products": "node --test --experimental-strip-types src/productSurfaces.test.ts",
    "test:deployment-routing": "node --test --experimental-strip-types tests/deployment/health.test.ts",
    "test:basic-pitch-model": "node scripts/verify-basic-pitch-model.mjs",
    "test:music-surfaces": "npm run test:basic-pitch-model && node --experimental-strip-types src/daw/services/transcriptionPrecisionService.test.ts && node --test src/daw/services/pianoTranscriptionService.test.mjs src/daw/services/scoreTransportSyncService.test.mjs",
    "test:auth-hardening": "node scripts/verify-auth-hardening.mjs && node --test --experimental-strip-types src/lib/authContract.test.ts src/lib/oauthConsent.test.ts",
    "test:contract": "node scripts/verify-ecosystem-contract.mjs",
    "quality:gates": "npm run typecheck && npm run test:audio-cloud && npm run test:audio-import && npm run test:portable-project && npm run test:responsive && npm run test:transport && npm run test:midi && npm run test:ai-safety && npm run test:app-resilience && npm run test:products && npm run test:deployment-routing && npm run test:music-surfaces && npm run test:auth-hardening && npm run test:contract && npm run build",
    "preview:edge": "npm run build && wrangler pages dev dist",
    "preview:vite": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@spotify/basic-pitch": "^1.0.1",
    "@studio-freight/lenis": "^1.0.42",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/supabase-js": "^2.105.1",
    "@tauri-apps/api": "^2.11.0",
    "gsap": "^3.14.2",
    "jszip": "^3.10.1",
    "lenis": "^1.3.17",
    "localforage": "^1.10.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260504.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.13",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^5.4.19",
    "wrangler": "^4.87.0"
  }
}
